        <!-- τ₂ at t=103 (after τ₁@100 finishes, tag detected). 28.5ms = ~80px. Preempted by τ₁@150 for 3ms. -->
        <mxCell id="t2_100a" value="auth_and_read" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fb923c;strokeColor=#fb923c;strokeWidth=0;fontColor=#fef3c7;fontSize=8;" vertex="1" parent="1">
