        <mxCell id="in_rf" value="&lt;b&gt;RF Carrier Field [13.56 MHz]&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;ISO/IEC 14443A Load Modulation&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#10b981;strokeWidth=2;fontColor=#ecfdf5;fontStyle=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="670" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="op_pack_auth" value="&lt;b&gt;OP1: PCD Auth Frame Pack&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;CMD || Block || CRC-A (16 µs)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#38bdf8;strokeWidth=2;fontColor=#f8fafc;fontStyle=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="350" width="220" height="65" as="geometry" />
        </mxCell>
