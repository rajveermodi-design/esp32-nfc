                <mxCell id="c_entry" value="&lt;b&gt;START: authenticate_and_read_block()&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9px;opacity:0.85;'&gt;Trigger: Valid PICC Serial Detected&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0f766e;strokeColor=#2dd4bf;strokeWidth=2;fontColor=#f0fdfa;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="560" y="90" width="280" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="d_load" value="&lt;b&gt;D1: Load Key A &amp; UID Operands&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9px;opacity:0.85;'&gt;KeyA = 0xFF*6 (6B), UID = rfid.uid (4B) | 2 µs&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#38bdf8;strokeWidth=2;fontColor=#f8fafc;fontStyle=0;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="560" y="180" width="280" height="55" as="geometry"/>
                </mxCell>
