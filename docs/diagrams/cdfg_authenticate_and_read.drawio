        <mxCell id="e105" value="Abort" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=4 3;strokeColor=#ef4444;strokeWidth=2;fontColor=#fca5a5;fontSize=10;labelBackgroundColor=#0f172a;" edge="1" parent="1" source="err_spi" target="d_cleanup">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e106" value="Wait RF Ack" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=6 4;strokeColor=#818cf8;strokeWidth=2;fontColor=#c7d2fe;fontSize=10;labelBackgroundColor=#0f172a;" edge="1" parent="1" source="d_tx_auth" target="c_ack">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e107" value="Yes (Acked)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=6 4;strokeColor=#818cf8;strokeWidth=2;fontColor=#c7d2fe;fontSize=10;labelBackgroundColor=#0f172a;" edge="1" parent="1" source="c_ack" target="d_crypto">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e108" value="Timeout (&gt;1.5ms)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=4 3;strokeColor=#ef4444;strokeWidth=2;fontColor=#fca5a5;fontSize=10;labelBackgroundColor=#0f172a;" edge="1" parent="1" source="c_ack" target="err_timeout">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e109" value="Abort" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=4 3;strokeColor=#ef4444;strokeWidth=2;fontColor=#fca5a5;fontSize=10;labelBackgroundColor=#0f172a;" edge="1" parent="1" source="err_timeout" target="d_cleanup">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e110" value="Enc Ready" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=6 4;strokeColor=#818cf8;strokeWidth=2;fontColor=#c7d2fe;fontSize=10;labelBackgroundColor=#0f172a;" edge="1" parent="1" source="d_crypto" target="d_tx_resp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e111" value="Wait Tag Token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=6 4;strokeColor=#818cf8;strokeWidth=2;fontColor=#c7d2fe;fontSize=10;labelBackgroundColor=#0f172a;" edge="1" parent="1" source="d_tx_resp" target="c_mutual">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e112" value="Yes (Auth OK)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=6 4;strokeColor=#818cf8;strokeWidth=2;fontColor=#c7d2fe;fontSize=10;labelBackgroundColor=#0f172a;" edge="1" parent="1" source="c_mutual" target="d_tx_read">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e113" value="No (Key Rejection)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=4 3;strokeColor=#ef4444;strokeWidth=2;fontColor=#fca5a5;fontSize=10;labelBackgroundColor=#0f172a;" edge="1" parent="1" source="c_mutual" target="err_auth">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e114" value="Abort" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=4 3;strokeColor=#ef4444;strokeWidth=2;fontColor=#fca5a5;fontSize=10;labelBackgroundColor=#0f172a;" edge="1" parent="1" source="err_auth" target="d_cleanup">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e115" value="Rx 16B Payload" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=6 4;strokeColor=#818cf8;strokeWidth=2;fontColor=#c7d2fe;fontSize=10;labelBackgroundColor=#0f172a;" edge="1" parent="1" source="d_tx_read" target="c_crc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e116" value="Yes (CRC Valid)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=6 4;strokeColor=#818cf8;strokeWidth=2;fontColor=#c7d2fe;fontSize=10;labelBackgroundColor=#0f172a;" edge="1" parent="1" source="c_crc" target="d_commit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e117" value="No (Checksum Err)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=4 3;strokeColor=#ef4444;strokeWidth=2;fontColor=#fca5a5;fontSize=10;labelBackgroundColor=#0f172a;" edge="1" parent="1" source="c_crc" target="err_crc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e118" value="Abort" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=4 3;strokeColor=#ef4444;strokeWidth=2;fontColor=#fca5a5;fontSize=10;labelBackgroundColor=#0f172a;" edge="1" parent="1" source="err_crc" target="d_cleanup">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e119" value="Success Exit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=6 4;strokeColor=#818cf8;strokeWidth=2;fontColor=#c7d2fe;fontSize=10;labelBackgroundColor=#0f172a;" edge="1" parent="1" source="d_commit" target="d_cleanup">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e120" value="Return Result" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=6 4;strokeColor=#818cf8;strokeWidth=2;fontColor=#c7d2fe;fontSize=10;labelBackgroundColor=#0f172a;" edge="1" parent="1" source="d_cleanup" target="c_exit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e121" value="Key A [48-bit]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10b981;strokeWidth=2.2;fontColor=#6ee7b7;fontSize=10;labelBackgroundColor=#0f172a;" edge="1" parent="1" source="data_key_storage" target="d_load">
          <mxGeometry relative="1" as="geometry" />
