        <mxCell id="e122" value="Demod Nonce" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10b981;strokeWidth=2.2;fontColor=#6ee7b7;fontSize=10;labelBackgroundColor=#0f172a;" edge="1" parent="1" source="d_crypto" target="data_nt_buf">
          <mxGeometry relative="1" as="geometry" />
