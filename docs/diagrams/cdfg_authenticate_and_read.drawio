  <diagram id="cdfg-function" name="3. CDFG - Critical Function (authenticate_and_read_block)">
    <mxGraphModel dx="1422" dy="798" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1180" background="#0f172a" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="hdr" value="&lt;b&gt;CONTROL DATA FLOW GRAPH (CDFG) — Critical-Path Function&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;Function: authenticate_and_read_block(block=4, keyA) | T_exec: 28,500 µs | Deadline: 35,000 µs | Slack: 6,500 µs&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontColor=#f8fafc;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="800" height="50" as="geometry" />
        </mxCell>
        <mxCell id="leg_ctrl" value="&lt;b&gt;Control Flow Edge&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#312e81;strokeColor=#818cf8;strokeWidth=2;fontColor=#e0e7ff;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="980" y="25" width="130" height="25" as="geometry" />
        </mxCell>
        <mxCell id="leg_data" value="&lt;b&gt;Data Flow Edge&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#10b981;strokeWidth=2;fontColor=#ecfdf5;fontStyle=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1120" y="25" width="130" height="25" as="geometry" />
        </mxCell>
        <mxCell id="leg_err" value="&lt;b&gt;Error / Rejection Trap&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#7f1d1d;strokeColor=#f87171;strokeWidth=2;fontColor=#fef2f2;fontStyle=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1260" y="25" width="140" height="25" as="geometry" />
        </mxCell>
        <mxCell id="c_entry" value="&lt;b&gt;START: authenticate_and_read_block()&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;Trigger: Valid PICC Serial Detected&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0f766e;strokeColor=#2dd4bf;strokeWidth=2;fontColor=#f0fdfa;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="90" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d_load" value="&lt;b&gt;D1: Load Key A &amp; UID Operands&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;KeyA = 0xFF*6 (6B), UID = rfid.uid (4B)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#38bdf8;strokeWidth=2;fontColor=#f8fafc;fontStyle=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="180" width="280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="c_spi_check" value="&lt;b&gt;C1: SPI Bus Ready?&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;Check PCD_Ready&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#312e81;strokeColor=#818cf8;strokeWidth=2;fontColor=#e0e7ff;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="610" y="270" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="err_spi" value="&lt;b&gt;ERR: SPI Bus Timeout&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;Set STATUS_SPI_ERR&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#7f1d1d;strokeColor=#f87171;strokeWidth=2;fontColor=#fef2f2;fontStyle=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="260" y="280" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d_tx_auth" value="&lt;b&gt;D2: Transmit MF_AUTH Command&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;0x60 || Block 0x04 || CRC-A (16 µs)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#38bdf8;strokeWidth=2;fontColor=#f8fafc;fontStyle=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="380" width="280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="c_ack" value="&lt;b&gt;C2: Tag Handshake Ack?&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;RF Response in &lt; 1.5 ms&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#312e81;strokeColor=#818cf8;strokeWidth=2;fontColor=#e0e7ff;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="610" y="470" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="err_timeout" value="&lt;b&gt;ERR: RF Timeout&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;Set STATUS_TIMEOUT&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#7f1d1d;strokeColor=#f87171;strokeWidth=2;fontColor=#fef2f2;fontStyle=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="260" y="480" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d_crypto" value="&lt;b&gt;D3: LFSR Init &amp; Reader Encrypt&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;Rx Nt -&gt; State0 = f(Key,UID,Nt) -&gt; Enc ar (42 µs)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#f59e0b;strokeWidth=2.5;fontColor=#fef3c7;fontStyle=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="580" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d_tx_resp" value="&lt;b&gt;D4: Transmit 64-bit Challenge Response&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;Send ar = Nr ^ k1..32 over RF (5,200 µs)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#f59e0b;strokeWidth=2.5;fontColor=#fef3c7;fontStyle=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="680" width="280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="c_mutual" value="&lt;b&gt;C3: Mutual Auth OK?&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;at == succ(Nt) verified&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#312e81;strokeColor=#818cf8;strokeWidth=2;fontColor=#e0e7ff;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="610" y="770" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="err_auth" value="&lt;b&gt;ERR: Auth Rejection&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;Spoof / Key Mismatch Detected&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#7f1d1d;strokeColor=#f87171;strokeWidth=2;fontColor=#fef2f2;fontStyle=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="260" y="780" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d_tx_read" value="&lt;b&gt;D5: Transmit Read Block 4 Cmd&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;0x30 || 0x04 || CRC-A ^ k65..96 (18 µs)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#38bdf8;strokeWidth=2;fontColor=#f8fafc;fontStyle=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="880" width="280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="c_crc" value="&lt;b&gt;C4: Payload CRC-16 Valid?&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;Verify ISO 14443-3 CRC&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#312e81;strokeColor=#818cf8;strokeWidth=2;fontColor=#e0e7ff;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="610" y="970" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="err_crc" value="&lt;b&gt;ERR: CRC Mismatch&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;Payload Corrupted&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#7f1d1d;strokeColor=#f87171;strokeWidth=2;fontColor=#fef2f2;fontStyle=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="260" y="980" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d_commit" value="&lt;b&gt;D6: Commit 16-Byte Block to Buffer&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;status = STATUS_OK | AUTH_SUCCESS&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#38bdf8;strokeWidth=2;fontColor=#f8fafc;fontStyle=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="1070" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d_cleanup" value="&lt;b&gt;CLEANUP: PCD &amp; PICC Teardown&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;rfid.PCD_StopCrypto1();
rfid.PICC_HaltA();&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#38bdf8;strokeWidth=2;fontColor=#f8fafc;fontStyle=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="980" y="620" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c_exit" value="&lt;b&gt;RETURN: authenticate_and_read_block()&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;Exit with Status &amp; Measured Delta_t&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0f766e;strokeColor=#2dd4bf;strokeWidth=2;fontColor=#f0fdfa;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="800" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="data_key_storage" value="&lt;b&gt;DATA: Key A Store [48-bit]&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;0xFF 0xFF 0xFF 0xFF 0xFF 0xFF&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#10b981;strokeWidth=2;fontColor=#ecfdf5;fontStyle=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="980" y="180" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="data_nt_buf" value="&lt;b&gt;DATA: Tag Nonce Nt [32-bit]&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;Captured over RF Demod&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#10b981;strokeWidth=2;fontColor=#ecfdf5;fontStyle=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="980" y="480" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="data_block_out" value="&lt;b&gt;DATA: Decrypted Block [16B]&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;Plaintext Memory Array&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#78350f;strokeColor=#f59e0b;strokeWidth=2;fontColor=#fef3c7;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="980" y="1070" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e101" value="Begin Exec" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=6 4;strokeColor=#818cf8;strokeWidth=2;fontColor=#c7d2fe;fontSize=10;labelBackgroundColor=#0f172a;" edge="1" parent="1" source="c_entry" target="d_load">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e102" value="Check Bus" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=6 4;strokeColor=#818cf8;strokeWidth=2;fontColor=#c7d2fe;fontSize=10;labelBackgroundColor=#0f172a;" edge="1" parent="1" source="d_load" target="c_spi_check">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e103" value="Yes (Bus Free)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=6 4;strokeColor=#818cf8;strokeWidth=2;fontColor=#c7d2fe;fontSize=10;labelBackgroundColor=#0f172a;" edge="1" parent="1" source="c_spi_check" target="d_tx_auth">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e104" value="No (Bus Busy)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=4 3;strokeColor=#ef4444;strokeWidth=2;fontColor=#fca5a5;fontSize=10;labelBackgroundColor=#0f172a;" edge="1" parent="1" source="c_spi_check" target="err_spi">
          <mxGeometry relative="1" as="geometry" />
