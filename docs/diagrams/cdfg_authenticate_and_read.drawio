                    <mxGeometry x="610" y="270" width="180" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="err_spi" value="&lt;b&gt;ERR: SPI Bus Timeout&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9px;opacity:0.85;'&gt;Set STATUS_SPI_ERR&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#7f1d1d;strokeColor=#f87171;strokeWidth=2;fontColor=#fef2f2;fontStyle=1;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="260" y="280" width="180" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="d_tx_auth" value="&lt;b&gt;D2: Transmit MF_AUTH Command&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9px;opacity:0.85;'&gt;0x60 || Block 0x04 || CRC-A | 16 µs&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#38bdf8;strokeWidth=2;fontColor=#f8fafc;fontStyle=0;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="560" y="380" width="280" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="c_ack" value="&lt;b&gt;C2: Tag Handshake Ack?&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9px;opacity:0.85;'&gt;RF Response in &lt; 1.5 ms (1,480 µs)&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#312e81;strokeColor=#818cf8;strokeWidth=2;fontColor=#e0e7ff;fontStyle=1;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="610" y="470" width="180" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="err_timeout" value="&lt;b&gt;ERR: RF Timeout&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9px;opacity:0.85;'&gt;Set STATUS_TIMEOUT&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#7f1d1d;strokeColor=#f87171;strokeWidth=2;fontColor=#fef2f2;fontStyle=1;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="260" y="480" width="180" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="d_crypto" value="&lt;b&gt;D3: LFSR Init &amp; Reader Encrypt&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9px;opacity:0.85;'&gt;Rx Nt -&gt; State0 = f(Key,UID,Nt) -&gt; Enc ar | 42 µs&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#f59e0b;strokeWidth=2.5;fontColor=#fef3c7;fontStyle=0;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="560" y="580" width="280" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="d_tx_resp" value="&lt;b&gt;D4: Transmit 64-bit Challenge Response&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9px;opacity:0.85;'&gt;Send ar = Nr ^ k1..32 over RF | 5,200 µs&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#f59e0b;strokeWidth=2.5;fontColor=#fef3c7;fontStyle=0;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="560" y="680" width="280" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="c_mutual" value="&lt;b&gt;C3: Mutual Auth OK?&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9px;opacity:0.85;'&gt;at == succ(Nt) verified (6,800 µs)&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#312e81;strokeColor=#818cf8;strokeWidth=2;fontColor=#e0e7ff;fontStyle=1;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="610" y="770" width="180" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="err_auth" value="&lt;b&gt;ERR: Auth Rejection&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9px;opacity:0.85;'&gt;Spoof / Key Mismatch Detected&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#7f1d1d;strokeColor=#f87171;strokeWidth=2;fontColor=#fef2f2;fontStyle=1;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="260" y="780" width="180" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="d_tx_read" value="&lt;b&gt;D5: Transmit Read Block 4 Cmd&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9px;opacity:0.85;'&gt;0x30 || 0x04 || CRC-A ^ k65..96 | 18 µs&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#38bdf8;strokeWidth=2;fontColor=#f8fafc;fontStyle=0;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="560" y="880" width="280" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="c_crc" value="&lt;b&gt;C4: Payload CRC-A Valid?&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9px;opacity:0.85;'&gt;Verify ISO 14443-3 CRC-A (22 µs)&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#312e81;strokeColor=#818cf8;strokeWidth=2;fontColor=#e0e7ff;fontStyle=1;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="610" y="970" width="180" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="err_crc" value="&lt;b&gt;ERR: CRC Mismatch&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9px;opacity:0.85;'&gt;Payload Corrupted&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#7f1d1d;strokeColor=#f87171;strokeWidth=2;fontColor=#fef2f2;fontStyle=1;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="260" y="980" width="180" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="d_commit" value="&lt;b&gt;D6: Commit 16-Byte Block to Buffer&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9px;opacity:0.85;'&gt;status = STATUS_OK | AUTH_SUCCESS | 5 µs&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#38bdf8;strokeWidth=2;fontColor=#f8fafc;fontStyle=0;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="560" y="1070" width="280" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="d_cleanup" value="&lt;b&gt;CLEANUP: PCD &amp; PICC Teardown&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9px;opacity:0.85;'&gt;rfid.PCD_StopCrypto1(); rfid.PICC_HaltA(); | 180 µs&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#38bdf8;strokeWidth=2;fontColor=#f8fafc;fontStyle=0;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="980" y="620" width="240" height="60" as="geometry"/>
