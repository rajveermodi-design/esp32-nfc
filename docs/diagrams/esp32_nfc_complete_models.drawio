          <mxGeometry x="60" y="540" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="in_rf" value="&lt;b&gt;RF Carrier Field [13.56 MHz]&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;ISO/IEC 14443A Load Modulation&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#10b981;strokeWidth=2;fontColor=#ecfdf5;fontStyle=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="670" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="op_pack_auth" value="&lt;b&gt;OP1: PCD Auth Frame Pack&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;CMD || Block || CRC-A (16 µs)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#38bdf8;strokeWidth=2;fontColor=#f8fafc;fontStyle=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="350" width="220" height="65" as="geometry" />
        </mxCell>
        <mxCell id="op_rf_demod" value="&lt;b&gt;OP2: RF Demod &amp; Sync&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;Capture 32-bit Nonce Nt (5,200 µs)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#f59e0b;strokeWidth=2.5;fontColor=#fef3c7;fontStyle=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="670" width="220" height="65" as="geometry" />
        </mxCell>
        <mxCell id="op_prng_reader" value="&lt;b&gt;OP3: Hardware PRNG&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;Generate 32-bit Nr (4 µs)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#38bdf8;strokeWidth=2;fontColor=#f8fafc;fontStyle=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="650" y="170" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="op_lfsr_init" value="&lt;b&gt;OP4: Crypto-1 LFSR Init&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;State0 = f(KeyA, UID, Nt) (28 µs)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#f59e0b;strokeWidth=2.5;fontColor=#fef3c7;fontStyle=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="650" y="370" width="220" height="65" as="geometry" />
        </mxCell>
        <mxCell id="op_keystream" value="&lt;b&gt;OP5: Non-Linear Keystream&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;fk(State) -&gt; ki bits (62 µs)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#f59e0b;strokeWidth=2.5;fontColor=#fef3c7;fontStyle=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="650" y="570" width="220" height="65" as="geometry" />
        </mxCell>
        <mxCell id="op_enc_reader" value="&lt;b&gt;OP6: Reader Challenge Enc&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;ar = Nr ^ k1..32 + parity (14 µs)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#f59e0b;strokeWidth=2.5;fontColor=#fef3c7;fontStyle=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="970" y="220" width="220" height="65" as="geometry" />
        </mxCell>
        <mxCell id="op_tag_auth" value="&lt;b&gt;OP7: Tag Response Verifier&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;at = Ciph ^ k33..64 == succ(Nt) (6,800 µs)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#f59e0b;strokeWidth=2.5;fontColor=#fef3c7;fontStyle=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="970" y="420" width="220" height="65" as="geometry" />
        </mxCell>
        <mxCell id="op_enc_read_cmd" value="&lt;b&gt;OP8: Encrypt Read Block Cmd&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;0x30 || 0x04 || CRC-A ^ k65..96 (18 µs)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#38bdf8;strokeWidth=2;fontColor=#f8fafc;fontStyle=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="970" y="620" width="220" height="65" as="geometry" />
        </mxCell>
        <mxCell id="op_stream_dec" value="&lt;b&gt;OP9: 16-Byte Payload Decrypt&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;Plain[0..15] = Ciph ^ k97..224 (42 µs)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#f59e0b;strokeWidth=2.5;fontColor=#fef3c7;fontStyle=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1280" y="320" width="220" height="65" as="geometry" />
