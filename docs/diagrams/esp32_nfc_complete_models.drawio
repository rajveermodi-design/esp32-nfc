        <mxCell id="crit_path_note" value="&lt;b&gt;━━ Critical Path (Yellow Highlight)&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;START→D1→C1(Y)→D2→C2(Y)→D3→D4→C3(Y)→D5→C4(Y)→D6→CLEANUP→RETURN
Total: 28,500 µs | Deadline: 35,000 µs | Slack: 6,500 µs (18.6%)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#f59e0b;strokeWidth=1.5;fontColor=#fde68a;fontStyle=0;fontSize=10;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
