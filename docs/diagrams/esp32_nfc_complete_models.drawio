  <diagram id="cdfg-critical-func" name="2. CDFG - Critical Function (authenticate_and_read_block)">
    <mxGraphModel dx="1600" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1400" background="#0f172a" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="hdr_card" value="&lt;b&gt;FIGURE 2: CONTROL DATA FLOW GRAPH (CDFG)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#94a3b8;&quot;&gt;Critical Path: authenticate_and_read_block() | Total Latency: 28,500 µs | Deadline: 35,000 µs | Slack: +6,500 µs&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#38bdf8;strokeWidth=2;fontColor=#f8fafc;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="1120" height="84" as="geometry" />
        </mxCell>
        <mxCell id="legend_card" value="&lt;b&gt;CDFG NOTATION &amp;amp; SPECIFICATION LEGEND&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;color:#38bdf8;&quot;&gt;● Operation (Circle)&lt;/span&gt; | &lt;span style=&quot;font-size:10px;color:#818cf8;&quot;&gt;◆ Decision (Diamond)&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;color:#10b981;&quot;&gt;━ Data Edge (Solid)&lt;/span&gt; | &lt;span style=&quot;font-size:10px;color:#818cf8;&quot;&gt;┈ Control Edge (Dashed)&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;color:#06b6d4;font-weight:bold;&quot;&gt;━━ Critical Path (Highlighted Cyan)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#475569;strokeWidth=1.5;fontColor=#f8fafc;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="1190" y="30" width="480" height="84" as="geometry" />
        </mxCell>
        <mxCell id="bb0" value="BB0: Initialisation &amp;amp; Param Load" style="swimlane;whiteSpace=wrap;html=1;fillColor=#0b1329;strokeColor=#38bdf8;fontColor=#38bdf8;startSize=26;fontSize=12;fontStyle=1;rounded=1;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
