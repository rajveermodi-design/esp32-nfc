<diagram id="fsm-behaviour" name="System-Behaviour FSM (Moore Machine)">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200" background="#0f172a" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;FIGURE 3: SYSTEM-BEHAVIOUR FINITE STATE MACHINE (Moore Machine)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;opacity:0.85;'&gt;Classification: Moore — Outputs determined solely by current state, not input events. Justification: Each state has deterministic physical outputs (RF field, display content, buzzer voltage, LED state) regardless of entry path, simplifying formal verification and safety analysis.&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontColor=#f8fafc;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="15" width="1200" height="55" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="leg_safe" value="&lt;b&gt;★ Safe State (S1_IDLE)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#10b981;strokeWidth=2;fontColor=#ecfdf5;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1300" y="15" width="170" height="25" as="geometry" />
        </mxCell>
        <mxCell id="leg_fault" value="&lt;b&gt;⚠ Fault State (S4_FAULT)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7f1d1d;strokeColor=#f87171;strokeWidth=2;fontColor=#fef2f2;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1300" y="45" width="170" height="25" as="geometry" />
        </mxCell>

        <!-- ======== STATES ======== -->

        <!-- S0_INIT -->
        <mxCell id="s0" value="&lt;b&gt;S0_INIT&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9px;opacity:0.85;'&gt;System Boot &amp; Peripheral Init&lt;/span&gt;&lt;hr size='1'/&gt;&lt;span style='font-size:8px;opacity:0.75;'&gt;OLED: &amp;quot;Initializing...&amp;quot;&lt;br/&gt;RF: OFF | Buzzer: 0V&lt;br/&gt;Wi-Fi: AP Starting | LED: Blink&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#38bdf8;strokeWidth=2.5;fontColor=#f8fafc;fontStyle=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="100" width="220" height="110" as="geometry" />
        </mxCell>

        <!-- S1_IDLE (Safe State) -->
        <mxCell id="s1" value="&lt;b&gt;★ S1_IDLE (SAFE STATE)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9px;opacity:0.85;'&gt;Waiting for Tag — RF Polling&lt;/span&gt;&lt;hr size='1'/&gt;&lt;span style='font-size:8px;opacity:0.75;'&gt;OLED: &amp;quot;Waiting for tag...&amp;quot;&lt;br/&gt;RF: Carrier ON (13.56 MHz polling)&lt;br/&gt;Buzzer: 0V | LED: Solid ON&lt;br/&gt;Crypto1: STOPPED | Files: CLOSED&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#10b981;strokeWidth=3;fontColor=#ecfdf5;fontStyle=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="620" y="340" width="260" height="140" as="geometry" />
        </mxCell>

        <!-- S2_READ_UID -->
        <mxCell id="s2" value="&lt;b&gt;S2_READ_UID&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9px;opacity:0.85;'&gt;UID Extraction &amp; Classification&lt;/span&gt;&lt;hr size='1'/&gt;&lt;span style='font-size:8px;opacity:0.75;'&gt;OLED: Updating...&lt;br/&gt;RF: Anti-collision active&lt;br/&gt;Buzzer: 0V | LED: ON&lt;br/&gt;Timer: startTime = micros()&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#38bdf8;strokeWidth=2.5;fontColor=#f8fafc;fontStyle=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="200" y="560" width="230" height="130" as="geometry" />
        </mxCell>

        <!-- S3_AUTH -->
        <mxCell id="s3" value="&lt;b&gt;S3_AUTH&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9px;opacity:0.85;'&gt;Cryptographic Sector Authentication&lt;/span&gt;&lt;hr size='1'/&gt;&lt;span style='font-size:8px;opacity:0.75;'&gt;OLED: &amp;quot;Authenticating...&amp;quot;&lt;br/&gt;RF: Crypto-1 session active&lt;br/&gt;Buzzer: 0V | LED: ON&lt;br/&gt;Deadline: 35,000 µs&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#312e81;strokeColor=#818cf8;strokeWidth=2.5;fontColor=#e0e7ff;fontStyle=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="200" y="800" width="230" height="130" as="geometry" />
        </mxCell>

        <!-- S4_FAULT -->
        <mxCell id="s4" value="&lt;b&gt;⚠ S4_FAULT&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9px;opacity:0.85;'&gt;Error / Rejection Trap&lt;/span&gt;&lt;hr size='1'/&gt;&lt;span style='font-size:8px;opacity:0.75;'&gt;OLED: Error message displayed&lt;br/&gt;RF: Carrier OFF (PICC_HaltA)&lt;br/&gt;Buzzer: 500 Hz × 200 ms&lt;br/&gt;LED: Fast Blink&lt;br/&gt;PCD_StopCrypto1() executed&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7f1d1d;strokeColor=#f87171;strokeWidth=3;fontColor=#fef2f2;fontStyle=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1070" y="680" width="240" height="150" as="geometry" />
        </mxCell>

        <!-- S5_LOG -->
        <mxCell id="s5" value="&lt;b&gt;S5_LOG&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9px;opacity:0.85;'&gt;Persist &amp; Display Result&lt;/span&gt;&lt;hr size='1'/&gt;&lt;span style='font-size:8px;opacity:0.75;'&gt;OLED: Scan result (UID, time, auth)&lt;br/&gt;RF: PICC_HaltA issued&lt;br/&gt;Buzzer: 1 kHz × 100 ms (success)&lt;br/&gt;LED: Solid ON&lt;br/&gt;LittleFS: file.flush() committed&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#78350f;strokeColor=#f59e0b;strokeWidth=2.5;fontColor=#fef3c7;fontStyle=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="920" width="230" height="150" as="geometry" />
        </mxCell>

        <!-- ======== TRANSITIONS ======== -->

        <!-- S0 → S1: boot_complete -->
        <mxCell id="t01" value="&lt;b&gt;boot_complete&lt;/b&gt;&lt;br/&gt;[SPI ∧ Wire ∧ LittleFS ∧ WiFi == OK]&lt;br/&gt;/ display(&amp;quot;System Online&amp;quot;)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#38bdf8;strokeWidth=2;fontColor=#7dd3fc;fontSize=9;labelBackgroundColor=#0f172a;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s0" target="s1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- S0 → S4: init_fail -->
        <mxCell id="t04" value="&lt;b&gt;init_fail&lt;/b&gt;&lt;br/&gt;[any peripheral returns false]&lt;br/&gt;/ Serial.println(&amp;quot;FATAL&amp;quot;)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#ef4444;strokeWidth=2;fontColor=#fca5a5;fontSize=9;labelBackgroundColor=#0f172a;exitX=1;exitY=0.7;entryX=1;entryY=0;" edge="1" parent="1" source="s0" target="s4">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1400" y="177" />
              <mxPoint x="1400" y="680" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- S1 → S2: tag_detected -->
        <mxCell id="t12" value="&lt;b&gt;tag_detected&lt;/b&gt;&lt;br/&gt;[PICC_IsNewCardPresent() == true]&lt;br/&gt;/ startTime = micros()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#38bdf8;strokeWidth=2;fontColor=#7dd3fc;fontSize=9;labelBackgroundColor=#0f172a;exitX=0;exitY=0.7;entryX=0.5;entryY=0;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- S1 → S1: http_request (self-loop) -->
        <mxCell id="t11" value="&lt;b&gt;http_request&lt;/b&gt;&lt;br/&gt;[AsyncWebServer callback]&lt;br/&gt;/ serve /api/logs JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#06b6d4;strokeWidth=1.5;fontColor=#67e8f9;fontSize=9;labelBackgroundColor=#0f172a;" edge="1" parent="1" source="s1" target="s1">
          <mxGeometry x="0.5" y="30" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="880" y="380" />
              <mxPoint x="940" y="380" />
              <mxPoint x="940" y="440" />
              <mxPoint x="880" y="440" />
            </Array>
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- S2 → S3: serial_read -->
        <mxCell id="t23" value="&lt;b&gt;serial_read&lt;/b&gt;&lt;br/&gt;[PICC_ReadCardSerial() == true]&lt;br/&gt;/ Extract UID; classify family" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#38bdf8;strokeWidth=2;fontColor=#7dd3fc;fontSize=9;labelBackgroundColor=#0f172a;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s2" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- S2 → S4: read_fail -->
        <mxCell id="t24" value="&lt;b&gt;read_fail&lt;/b&gt;&lt;br/&gt;[PICC_ReadCardSerial() == false]&lt;br/&gt;/ —" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#ef4444;strokeWidth=2;fontColor=#fca5a5;fontSize=9;labelBackgroundColor=#0f172a;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="s2" target="s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- S3 → S5: auth_success -->
        <mxCell id="t35" value="&lt;b&gt;auth_success&lt;/b&gt;&lt;br/&gt;[PCD_Authenticate() == STATUS_OK]&lt;br/&gt;/ Read block; compute Δt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#f59e0b;strokeWidth=2;fontColor=#fde68a;fontSize=9;labelBackgroundColor=#0f172a;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="s3" target="s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- S3 → S4: auth_fail -->
        <mxCell id="t34a" value="&lt;b&gt;auth_fail&lt;/b&gt;&lt;br/&gt;[PCD_Authenticate() != STATUS_OK]&lt;br/&gt;/ authStatus = &amp;quot;AUTH_FAILED&amp;quot;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#ef4444;strokeWidth=2;fontColor=#fca5a5;fontSize=9;labelBackgroundColor=#0f172a;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s3" target="s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- S3 → S4: timeout -->
        <mxCell id="t34b" value="&lt;b&gt;timeout&lt;/b&gt;&lt;br/&gt;[RF response &amp;gt; 35,000 µs]&lt;br/&gt;/ Abort crypto session" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#ef4444;strokeWidth=1.5;fontColor=#fca5a5;fontSize=9;labelBackgroundColor=#0f172a;exitX=1;exitY=0.8;entryX=0;entryY=0.7;" edge="1" parent="1" source="s3" target="s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- S3 → S4: crc_error -->
        <mxCell id="t34c" value="&lt;b&gt;crc_error&lt;/b&gt;&lt;br/&gt;[CRC-A mismatch on payload]&lt;br/&gt;/ —" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#ef4444;strokeWidth=1.5;fontColor=#fca5a5;fontSize=9;labelBackgroundColor=#0f172a;exitX=1;exitY=0.3;entryX=0;entryY=0.15;" edge="1" parent="1" source="s3" target="s4">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="700" y="840" />
              <mxPoint x="700" y="703" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- S4 → S1: fault_handled -->
        <mxCell id="t41" value="&lt;b&gt;fault_handled&lt;/b&gt;&lt;br/&gt;[always]&lt;br/&gt;/ PICC_HaltA(); PCD_StopCrypto1();&lt;br/&gt;  appendScanRecord(..., &amp;quot;FAILED&amp;quot;)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10b981;strokeWidth=2.5;fontColor=#6ee7b7;fontSize=9;labelBackgroundColor=#0f172a;exitX=0.5;exitY=0;entryX=1;entryY=0.5;" edge="1" parent="1" source="s4" target="s1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1190" y="410" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- S5 → S1: log_complete -->
        <mxCell id="t51" value="&lt;b&gt;log_complete&lt;/b&gt;&lt;br/&gt;[file.flush() returns]&lt;br/&gt;/ PICC_HaltA(); PCD_StopCrypto1(); delay(1500)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10b981;strokeWidth=2.5;fontColor=#6ee7b7;fontSize=9;labelBackgroundColor=#0f172a;exitX=1;exitY=0;entryX=0.7;entryY=1;" edge="1" parent="1" source="s5" target="s1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="870" y="920" />
              <mxPoint x="870" y="490" />
              <mxPoint x="802" y="490" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- State Transition Matrix Note -->
        <mxCell id="stm_note" value="&lt;b&gt;State Transition Completeness:&lt;/b&gt; Every state has at least one outgoing transition. S4_FAULT always recovers to S1_IDLE (safe state). Self-loop on S1_IDLE handles async HTTP events without state change. No undefined or dangling transitions exist." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontColor=#94a3b8;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="40" y="1100" width="700" height="30" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
<diagram id="task-schedule" name="Task Schedule &amp; Hyperperiod Timeline">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1400" background="#0f172a" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;FIGURE 4: TASK SCHEDULE, RMS SCHEDULABILITY PROOF &amp; HYPERPERIOD TIMELINE&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;opacity:0.85;'&gt;Rate-Monotonic Scheduling (RMS) — Fixed-Priority Preemptive | Hyperperiod = LCM(50, 200, 1000, 1000, 5000) = 5000 ms&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontColor=#f8fafc;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="15" width="1000" height="50" as="geometry" />
        </mxCell>

        <!-- ======== TASK TABLE ======== -->
        <mxCell id="table_title" value="&lt;b&gt;TASK SET DEFINITION&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontColor=#38bdf8;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="75" width="300" height="25" as="geometry" />
        </mxCell>

        <!-- Table Header -->
        <mxCell id="th" value="&lt;table style='border-collapse:collapse;color:#f8fafc;font-size:10px;width:100%;'&gt;&lt;tr style='background:#1e293b;font-weight:bold;'&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;Task ID&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;Task Name&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;Trigger&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;Period T (ms)&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;WCET C (ms)&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;Deadline D (ms)&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;Priority&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;U = C/T&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;Measurement Source&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#0f172a;'&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;color:#f87171;font-weight:bold;'&gt;τ₁&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;rf_poll_task&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;Periodic&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;50&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;3.0&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;50&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;1 (Highest)&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;0.0600&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;micros() delta on PICC_IsNewCardPresent()&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#1e293b;'&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;color:#fb923c;font-weight:bold;'&gt;τ₂&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;authenticate_and_read_block&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;Sporadic (tag)&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;1000&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;28.5&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;35.0&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;2&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;0.0285&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;Empirical benchmark (Review2 §2.3)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#0f172a;'&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;color:#818cf8;font-weight:bold;'&gt;τ₃&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;update_oled_ui&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;Periodic&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;200&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;4.2&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;200&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;3&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;0.0210&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;Candidate table (Review2 §2.1)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#1e293b;'&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;color:#10b981;font-weight:bold;'&gt;τ₄&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;littlefs_flush_task&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;Sporadic (scan)&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;1000&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;8.0&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;100&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;4&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;0.0080&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;Est: serializeJson() + file.flush()&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#0f172a;'&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;color:#06b6d4;font-weight:bold;'&gt;τ₅&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;async_http_handler&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;Sporadic (HTTP)&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;5000&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;2.0&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;5000&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;5 (Lowest)&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;0.0004&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 8px;'&gt;ESPAsyncWebServer response latency&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=#475569;fillColor=#0f172a;align=left;verticalAlign=top;rounded=1;fontColor=#f8fafc;overflow=auto;" vertex="1" parent="1">
          <mxGeometry x="40" y="105" width="1400" height="195" as="geometry" />
        </mxCell>

        <!-- ======== RMS PROOF ======== -->
        <mxCell id="rms_title" value="&lt;b&gt;RATE-MONOTONIC SCHEDULABILITY PROOF&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontColor=#38bdf8;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="400" height="25" as="geometry" />
        </mxCell>
        <mxCell id="rms_proof" value="&lt;div style='font-family:monospace;font-size:11px;color:#f8fafc;line-height:1.6;'&gt;&lt;b style='color:#38bdf8;'&gt;Liu &amp; Layland (1973) Sufficient Condition for n = 5 tasks:&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;U_bound = n × (2^(1/n) − 1) = 5 × (2^(1/5) − 1) = 5 × (2^0.2 − 1) = 5 × 0.14870 = &lt;b style='color:#10b981;'&gt;0.74349&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b style='color:#38bdf8;'&gt;Total System Utilization:&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;U_total = U₁ + U₂ + U₃ + U₄ + U₅&lt;br/&gt;U_total = C₁/T₁ + C₂/T₂ + C₃/T₃ + C₄/T₄ + C₅/T₅&lt;br/&gt;U_total = 3.0/50 + 28.5/1000 + 4.2/200 + 8.0/1000 + 2.0/5000&lt;br/&gt;U_total = 0.0600 + 0.0285 + 0.0210 + 0.0080 + 0.0004&lt;br/&gt;U_total = &lt;b style='color:#f59e0b;'&gt;0.1179&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b style='color:#10b981;'&gt;✓ U_total = 0.1179 ≤ 0.7435 = U_bound&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b style='color:#10b981;'&gt;∴ The task set is GUARANTEED SCHEDULABLE under RMS.&lt;/b&gt;&lt;br/&gt;System operates at &lt;b&gt;15.9%&lt;/b&gt; of utilization ceiling → substantial headroom for future tasks.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#10b981;strokeWidth=2;fontColor=#f8fafc;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;spacingRight=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="350" width="680" height="310" as="geometry" />
        </mxCell>

        <!-- ======== SHARED RESOURCES ======== -->
        <mxCell id="sr_title" value="&lt;b&gt;SHARED RESOURCE PROTECTION&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontColor=#38bdf8;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="320" width="300" height="25" as="geometry" />
        </mxCell>
        <mxCell id="sr_table" value="&lt;table style='border-collapse:collapse;color:#f8fafc;font-size:10px;width:100%;'&gt;&lt;tr style='background:#1e293b;font-weight:bold;'&gt;&lt;td style='border:1px solid #475569;padding:4px 6px;'&gt;Resource&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 6px;'&gt;Contending Tasks&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 6px;'&gt;Protection&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 6px;'&gt;Max Block (ms)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#0f172a;'&gt;&lt;td style='border:1px solid #475569;padding:4px 6px;color:#818cf8;'&gt;SPI Bus (HSPI)&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 6px;'&gt;τ₁, τ₂&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 6px;'&gt;Binary Mutex (xSemaphoreTake)&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 6px;'&gt;28.5&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#1e293b;'&gt;&lt;td style='border:1px solid #475569;padding:4px 6px;color:#10b981;'&gt;I2C Bus (Wire)&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 6px;'&gt;τ₃ only&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 6px;'&gt;N/A (single consumer)&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 6px;'&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#0f172a;'&gt;&lt;td style='border:1px solid #475569;padding:4px 6px;color:#a78bfa;'&gt;LittleFS File&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 6px;'&gt;τ₂/τ₄ (write), τ₅ (read)&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 6px;'&gt;Mutex / portENTER_CRITICAL()&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 6px;'&gt;8.0&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#1e293b;'&gt;&lt;td style='border:1px solid #475569;padding:4px 6px;color:#06b6d4;'&gt;HTTP Response Buffer&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 6px;'&gt;τ₅&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 6px;'&gt;FreeRTOS task isolation (Core 0)&lt;/td&gt;&lt;td style='border:1px solid #475569;padding:4px 6px;'&gt;2.0&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=#475569;fillColor=#0f172a;align=left;verticalAlign=top;rounded=1;fontColor=#f8fafc;overflow=auto;" vertex="1" parent="1">
          <mxGeometry x="760" y="350" width="680" height="165" as="geometry" />
        </mxCell>

        <!-- ======== HYPERPERIOD TIMELINE ======== -->
        <mxCell id="tl_title" value="&lt;b&gt;HYPERPERIOD TIMELINE (0 — 5000 ms)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9px;opacity:0.85;'&gt;Showing first 500 ms detail window — τ₁ executes every 50 ms (highest priority), τ₃ every 200 ms. Sporadic tasks τ₂, τ₄ triggered at t=100 ms (tag arrival). Idle time shown in gray.&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontColor=#38bdf8;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="690" width="800" height="40" as="geometry" />
        </mxCell>

        <!-- Timeline Y-axis labels -->
        <mxCell id="tl_y1" value="&lt;b&gt;τ₁ rf_poll (P=1)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;rounded=0;fontColor=#f87171;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="745" width="130" height="30" as="geometry" />
        </mxCell>
        <mxCell id="tl_y2" value="&lt;b&gt;τ₂ auth_read (P=2)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;rounded=0;fontColor=#fb923c;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="790" width="130" height="30" as="geometry" />
        </mxCell>
        <mxCell id="tl_y3" value="&lt;b&gt;τ₃ oled_ui (P=3)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;rounded=0;fontColor=#818cf8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="835" width="130" height="30" as="geometry" />
        </mxCell>
        <mxCell id="tl_y4" value="&lt;b&gt;τ₄ lfs_flush (P=4)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;rounded=0;fontColor=#10b981;fontSize=10;" vertex="1" parent="1">
