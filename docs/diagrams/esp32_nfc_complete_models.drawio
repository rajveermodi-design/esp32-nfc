        <mxCell id="n_start" value="&lt;b&gt;START: authenticate_and_read_block()&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;&quot;&gt;Trigger: Valid Card UID Detected&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f766e;strokeColor=#2dd4bf;strokeWidth=2;fontColor=#f0fdfa;" vertex="1" parent="1">
          <mxGeometry x="630" y="130" width="280" height="38" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="&lt;b&gt;N1: Load Key A &amp;amp; Target Block&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;color:#38bdf8;&quot;&gt;Cost: 1 µs (240 cycles)&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#06b6d4;strokeWidth=2.5;fontColor=#f8fafc;" vertex="1" parent="bb0">
          <mxGeometry x="130" y="32" width="340" height="54" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="&lt;b&gt;N2: Send MF_AUTH (0x60)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;color:#38bdf8;&quot;&gt;Cost: 500 µs (120k cycles)&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#06b6d4;strokeWidth=2.5;fontColor=#f8fafc;" vertex="1" parent="bb1">
          <mxGeometry x="130" y="34" width="340" height="54" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="&lt;b&gt;D1: FIFO Ready?&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;color:#c7d2fe;&quot;&gt;Cost: 10 µs (2.4k cycles)&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#312e81;strokeColor=#818cf8;strokeWidth=2.2;fontColor=#e0e7ff;" vertex="1" parent="bb1">
          <mxGeometry x="190" y="120" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;N3: Transmit 6-Byte Key A&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;color:#38bdf8;&quot;&gt;Cost: 6,000 µs (1.44M cycles)&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#06b6d4;strokeWidth=2.5;fontColor=#f8fafc;" vertex="1" parent="bb2">
          <mxGeometry x="130" y="34" width="340" height="54" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="&lt;b&gt;D2: Crypto-1 Match?&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;color:#c7d2fe;&quot;&gt;Cost: 300 µs (72k cycles)&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#312e81;strokeColor=#818cf8;strokeWidth=2.2;fontColor=#e0e7ff;" vertex="1" parent="bb2">
          <mxGeometry x="190" y="120" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;N4: Send READ Cmd (0x30)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;color:#38bdf8;&quot;&gt;Cost: 1,000 µs (240k cycles)&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#06b6d4;strokeWidth=2.5;fontColor=#f8fafc;" vertex="1" parent="bb3">
          <mxGeometry x="130" y="34" width="340" height="52" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;N5: Read 16B Block via FIFO&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;color:#38bdf8;&quot;&gt;Cost: 12,000 µs (2.88M cycles)&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#06b6d4;strokeWidth=2.5;fontColor=#f8fafc;" vertex="1" parent="bb3">
          <mxGeometry x="130" y="118" width="340" height="52" as="geometry" />
