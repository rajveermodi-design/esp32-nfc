        <mxCell id="bb2" value="BB2: Cryptographic Handshake" style="swimlane;whiteSpace=wrap;html=1;fillColor=#0b1329;strokeColor=#38bdf8;fontColor=#38bdf8;startSize=26;fontSize=12;fontStyle=1;rounded=1;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
          <mxGeometry x="470" y="600" width="600" height="195" as="geometry" />
        </mxCell>
        <mxCell id="bb3" value="BB3: Encrypted Block Extraction" style="swimlane;whiteSpace=wrap;html=1;fillColor=#0b1329;strokeColor=#38bdf8;fontColor=#38bdf8;startSize=26;fontSize=12;fontStyle=1;rounded=1;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
          <mxGeometry x="470" y="850" width="600" height="275" as="geometry" />
        </mxCell>
