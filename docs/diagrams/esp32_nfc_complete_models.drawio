          <mxGeometry x="470" y="1175" width="600" height="100" as="geometry" />
        </mxCell>
        <mxCell id="bb_fault" value="BB_FAULT: Error Recovery Block" style="swimlane;whiteSpace=wrap;html=1;fillColor=#1c0f14;strokeColor=#ef4444;fontColor=#fca5a5;startSize=26;fontSize=12;fontStyle=1;rounded=1;strokeWidth=1.8;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
          <mxGeometry x="1190" y="450" width="480" height="370" as="geometry" />
