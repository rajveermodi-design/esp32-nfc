          <mxGeometry x="260" y="480" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d_crypto" value="&lt;b&gt;D3: LFSR Init &amp; Reader Encrypt&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;Rx Nt -&gt; State0 = f(Key,UID,Nt) -&gt; Enc ar | 42 µs&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#f59e0b;strokeWidth=2.5;fontColor=#fef3c7;fontStyle=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="580" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d_tx_resp" value="&lt;b&gt;D4: Transmit 64-bit Challenge Response&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;Send ar = Nr ^ k1..32 over RF | 5,200 µs&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#f59e0b;strokeWidth=2.5;fontColor=#fef3c7;fontStyle=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="680" width="280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="c_mutual" value="&lt;b&gt;C3: Mutual Auth OK?&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;at == succ(Nt) verified (6,800 µs)&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#312e81;strokeColor=#818cf8;strokeWidth=2;fontColor=#e0e7ff;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="610" y="770" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="err_auth" value="&lt;b&gt;ERR: Auth Rejection&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;Spoof / Key Mismatch Detected&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#7f1d1d;strokeColor=#f87171;strokeWidth=2;fontColor=#fef2f2;fontStyle=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="260" y="780" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d_tx_read" value="&lt;b&gt;D5: Transmit Read Block 4 Cmd&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;0x30 || 0x04 || CRC-A ^ k65..96 | 18 µs&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#38bdf8;strokeWidth=2;fontColor=#f8fafc;fontStyle=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="880" width="280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="c_crc" value="&lt;b&gt;C4: Payload CRC-A Valid?&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;Verify ISO 14443-3 CRC-A (22 µs)&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#312e81;strokeColor=#818cf8;strokeWidth=2;fontColor=#e0e7ff;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="610" y="970" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="err_crc" value="&lt;b&gt;ERR: CRC Mismatch&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;Payload Corrupted&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#7f1d1d;strokeColor=#f87171;strokeWidth=2;fontColor=#fef2f2;fontStyle=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="260" y="980" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d_commit" value="&lt;b&gt;D6: Commit 16-Byte Block to Buffer&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;status = STATUS_OK | AUTH_SUCCESS | 5 µs&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#38bdf8;strokeWidth=2;fontColor=#f8fafc;fontStyle=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="1070" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d_cleanup" value="&lt;b&gt;CLEANUP: PCD &amp; PICC Teardown&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;rfid.PCD_StopCrypto1(); rfid.PICC_HaltA(); | 180 µs&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#38bdf8;strokeWidth=2;fontColor=#f8fafc;fontStyle=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="980" y="620" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c_exit" value="&lt;b&gt;RETURN: authenticate_and_read_block()&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;Exit with Status &amp; Measured Delta_t&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0f766e;strokeColor=#2dd4bf;strokeWidth=2;fontColor=#f0fdfa;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="800" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="data_key_storage" value="&lt;b&gt;DATA: Key A Store [48-bit]&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;0xFF 0xFF 0xFF 0xFF 0xFF 0xFF&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#10b981;strokeWidth=2;fontColor=#ecfdf5;fontStyle=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="980" y="180" width="220" height="50" as="geometry" />
