        <mxCell id="hdr" value="&lt;b&gt;DATA FLOW GRAPH (DFG) — Critical-Path Cryptographic Authentication &amp; Block Read&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;Function: authenticate_and_read_block() | Critical Path Latency: 28,500 µs | Deadline: 35,000 µs&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontColor=#f8fafc;" vertex="1" parent="1">
