        <mxCell id="hdr" value="&lt;b&gt;CONTROL DATA FLOW GRAPH (CDFG) — System-Level Dual-Mode NFC Analysis Engine&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;ESP32 Dual-Mode Engine: Level 1 UID Unauthenticated vs Level 2 Cryptographic Sector | LittleFS Flash Persistence &amp; OLED UI&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontColor=#f8fafc;" vertex="1" parent="1">
