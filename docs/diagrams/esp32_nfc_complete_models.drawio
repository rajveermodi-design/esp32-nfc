          <mxGeometry x="60" y="640" width="210" height="55" as="geometry" />
        </mxCell>
        <mxCell id="src_uptime" value="&lt;b&gt;System Uptime [32-bit]&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;millis() since boot&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#10b981;strokeWidth=2;fontColor=#ecfdf5;fontStyle=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="740" width="210" height="55" as="geometry" />
        </mxCell>
        <mxCell id="op_sub_time" value="&lt;b&gt;OP1: Delta-t Latency Subtractor&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;Delta_t = t1 - t0 (1.2 µs)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#f59e0b;strokeWidth=2.5;fontColor=#fef3c7;fontStyle=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="180" width="230" height="65" as="geometry" />
        </mxCell>
        <mxCell id="op_hex_fmt" value="&lt;b&gt;OP2: UID Hex-ASCII Serializer&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;uidByte[] -&gt; &quot;AA:BB:CC:DD&quot; (14.5 µs)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#38bdf8;strokeWidth=2;fontColor=#f8fafc;fontStyle=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="330" width="230" height="65" as="geometry" />
        </mxCell>
        <mxCell id="op_classify" value="&lt;b&gt;OP3: Tag Family Classifier&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;size==7 ? NTAG : MIFARE (0.8 µs)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#38bdf8;strokeWidth=2;fontColor=#f8fafc;fontStyle=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="490" width="230" height="65" as="geometry" />
        </mxCell>
        <mxCell id="op_oled_blit" value="&lt;b&gt;OP4: SSD1306 Glyph Rasterizer&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;Convert text to 128x64 bitmask (2.1 ms)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#38bdf8;strokeWidth=2;fontColor=#f8fafc;fontStyle=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="660" y="230" width="240" height="65" as="geometry" />
        </mxCell>
        <mxCell id="op_json_doc" value="&lt;b&gt;OP5: ArduinoJson DOM Builder&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;StaticJsonDocument&lt;256&gt; (18.2 µs)
timestamp, uid, read_time_us, status&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#38bdf8;strokeWidth=2;fontColor=#f8fafc;fontStyle=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="660" y="520" width="240" height="75" as="geometry" />
        </mxCell>
        <mxCell id="op_i2c_bus" value="&lt;b&gt;OP6: I2C Fast-Mode Transmit&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;400 kHz Wire Buffer Tx (2,050 µs)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#38bdf8;strokeWidth=2;fontColor=#f8fafc;fontStyle=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="980" y="230" width="230" height="65" as="geometry" />
        </mxCell>
        <mxCell id="op_jsonl_ser" value="&lt;b&gt;OP7: JSONL Line Serializer&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;serializeJson(doc, file) (32.4 µs)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#38bdf8;strokeWidth=2;fontColor=#f8fafc;fontStyle=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="980" y="480" width="230" height="65" as="geometry" />
        </mxCell>
        <mxCell id="op_flash_flush" value="&lt;b&gt;OP8: LittleFS Page Cache Flush&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;SPI Physical Flash Commit (3,800 µs)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#f59e0b;strokeWidth=2.5;fontColor=#fef3c7;fontStyle=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="980" y="640" width="230" height="65" as="geometry" />
        </mxCell>
        <mxCell id="sink_oled" value="&lt;b&gt;SINK 1: OLED Display Screen&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;128x64 Monochrome Pixel Grid&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#78350f;strokeColor=#f59e0b;strokeWidth=2;fontColor=#fef3c7;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1290" y="230" width="210" height="65" as="geometry" />
        </mxCell>
        <mxCell id="sink_flash" value="&lt;b&gt;SINK 2: LittleFS Physical Flash&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;/scans.jsonl Partition (Non-Volatile)&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#78350f;strokeColor=#f59e0b;strokeWidth=2;fontColor=#fef3c7;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1290" y="560" width="210" height="65" as="geometry" />
        </mxCell>
        <mxCell id="sink_web" value="&lt;b&gt;SINK 3: Async Web Client Buffer&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:9px;opacity:0.85;&#x27;&gt;/api/logs REST API Stream (WiFi AP)&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#78350f;strokeColor=#f59e0b;strokeWidth=2;fontColor=#fef3c7;fontStyle=1;fontSize=11;" vertex="1" parent="1">
