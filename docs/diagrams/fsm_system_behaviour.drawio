  <diagram id="fsm-moore-model" name="3. FSM - System Moore Model">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="980" pageHeight="600" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="s0" value="&lt;b&gt;S0: IDLE (Safe State)&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;border:none;border-top:1px solid #000000;&quot;/&gt;OLED: Ready | Buzzer: Off | LittleFS: Closed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;arcSize=10;align=center;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="300" y="50" width="340" height="65" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;S1: DETECT_TAG&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;border:none;border-top:1px solid #000000;&quot;/&gt;OLED: Tag Detected | Buzzer: 30ms Pulse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;arcSize=10;align=center;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="300" y="165" width="340" height="65" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;S2: AUTH_SECTOR&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;border:none;border-top:1px solid #000000;&quot;/&gt;OLED: Authenticating... | Buzzer: Off" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;arcSize=10;align=center;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="300" y="280" width="340" height="65" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;S3: LOG_PERSIST&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;border:none;border-top:1px solid #000000;&quot;/&gt;OLED: Access Granted | Buzzer: 100ms Chirp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;arcSize=10;align=center;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="300" y="395" width="340" height="65" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;S4: FAULT&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;border:none;border-top:1px solid #000000;&quot;/&gt;OLED: Read/Auth Error | Buzzer: Double Buzz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;arcSize=10;align=center;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="710" y="220" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="E1: Tag_Detect [Carrier_Present]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="E2: Parse_OK [Valid_ISO14443A]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="E3: Parse_Fail [CRC_Error]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="s1" target="s4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="770" y="197"/></Array></mxGeometry></mxCell>
        <mxCell id="e4" value="E4: Auth_OK [Key_A_Match]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="E5: Auth_Fail [Mismatch / Timeout]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="s2" target="s4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="770" y="312"/></Array></mxGeometry></mxCell>
        <mxCell id="e6" value="E6: Commit_Done [File_Flushed]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="s3" target="s0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="180" y="427"/><mxPoint x="180" y="82"/></Array></mxGeometry></mxCell>
        <mxCell id="e7" value="E7: Timeout_Expire [t &gt;= 1500ms]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="s4" target="s0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="825" y="25"/><mxPoint x="470" y="25"/></Array></mxGeometry></mxCell>
        <mxCell id="card_fsm" value="&lt;b&gt;Moore FSM Model:&lt;/b&gt;&lt;br/&gt;• Outputs = $\lambda(S)$&lt;br/&gt;  Strictly state-dependent.&lt;br/&gt;  Zero GPIO glitches.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Safe Quiescent:&lt;/b&gt;&lt;br/&gt;• S0: IDLE is safe&lt;br/&gt;  baseline state.&lt;br/&gt;• Dual loops (E6, E7)&lt;br/&gt;  guarantee bounded&lt;br/&gt;  return to S0 without&lt;br/&gt;  microcontroller reset." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontSize=10;align=left;spacingLeft=8;spacingTop=8;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="145" width="125" height="210" as="geometry" />
        </mxCell>
        <mxCell id="cap_fig3" value="&lt;b&gt;Figure 3&lt;/b&gt; — System Moore Finite State Machine showing guarded operational states, safe state, and fault recovery." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=#000000;fontSize=11.5;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="900" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
