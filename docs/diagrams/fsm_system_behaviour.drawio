        <mxCell id="hdr_fsm" value="&lt;b&gt;FIGURE 3: SYSTEM-BEHAVIOUR FINITE STATE MACHINE (MOORE MODEL)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#94a3b8;&quot;&gt;Access Control Terminal Lifecycle: S0_IDLE (Safe State) -&amp;gt; Verification -&amp;gt; Persistence -&amp;gt; Fault Recovery&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#38bdf8;strokeWidth=2;fontColor=#f8fafc;align=left;spacingLeft=15;" vertex="1" parent="1">
